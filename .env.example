# .env.example — environment key surface for the P0 Lab foundation increment.
#
# Copy to .env and fill in values locally. .env is git-ignored; this template is
# committed deliberately so every key that exists is visible here
# (specs/001-lab-foundation-bootstrap/data-model.md §5).
#
# Only keys this increment (المراحل 0–2) actually needs are listed. Nothing else.

# --- Lab database (PostgreSQL 17 + pgvector, container on 127.0.0.1:5433) ---
LAB_DB_HOST=127.0.0.1
LAB_DB_PORT=5433
LAB_DB_DATABASE=injazedu_lab
LAB_DB_USERNAME=lab
# Empty in the template. Startup fails if unset (FR-022) — there is no default.
LAB_DB_PASSWORD=

# --- Snapshot provenance (docs/runbooks/snapshot.md) ---
# Date the production snapshot was taken. Stamped on every later report.
SNAPSHOT_TAKEN_AT=2026-08-07

# ---------------------------------------------------------------------------
# Keys deliberately ABSENT — their absence is an acceptance criterion.
# Each belongs to a later phase and must not be added early:
#   - SNAPSHOT_DB_*            → المرحلة 3 (read-only snapshot access)
#   - SNAPSHOT_DB_ROOT_*       → never. No root credentials, ever.
#   - STUDENT_REF_PEPPER       → المرحلة 8
#   - PRODUCTION_WRITE_ENABLED → المرحلة 8
#   - EMBEDDING_CONFIG_VERSION → المرحلة 6
# ---------------------------------------------------------------------------
