# apps/lab/.env.example — every key, no values. Copy to apps/lab/.env and fill in.
#
# This file is the committed contract for the application's environment surface.
# Docker Compose reads the root /.env instead; the one value the two files share
# is DB_PASSWORD here = LAB_DB_PASSWORD there (scripts/verify-lab-app.sh asserts it).
#
# INJAZEDU_DB_PASSWORD stays empty in the real file too — root with an empty
# password is the approved architecture (ADR-021); read-only is enforced by the
# application, never by MySQL.
#
# Keys that belong to later phases and must not appear early:
# STUDENT_REF_PEPPER (المرحلة 8), EMBEDDING_CONFIG_VERSION (المرحلة 6).

# --- Application ---
APP_NAME=
APP_ENV=
APP_KEY=
APP_DEBUG=
APP_URL=

# --- Lab database (default connection — PostgreSQL 17 + pgvector, container on 127.0.0.1:5433) ---
DB_CONNECTION=
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# --- InjazEdu source (MySQL 9.1, native, 127.0.0.1:3306) ---
INJAZEDU_DB_HOST=
INJAZEDU_DB_PORT=
INJAZEDU_DB_DATABASE=
INJAZEDU_DB_USERNAME=
INJAZEDU_DB_PASSWORD=

# --- Queue and logs ---
QUEUE_CONNECTION=
LOG_CHANNEL=
LOG_LEVEL=

# --- Provenance ---
SNAPSHOT_TAKEN_AT=

# --- Model runtime ---
OLLAMA_HOST=
