# apps/ai-service/.env.example — every key the service reads, with NO values.
#
# NO MySQL key belongs in this file — ever. The service holds no credential for
# the InjazEdu source; every source read goes through Laravel's guarded
# connection (ADR-013, FR-003). If you find yourself adding INJAZEDU_DB_* here,
# stop — that is the boundary this file exists to hold.

# Lab database (PostgreSQL, read-only usage; SELECT 1 + server version only)
LAB_DB_HOST=
LAB_DB_PORT=
LAB_DB_NAME=
LAB_DB_USER=
LAB_DB_PASSWORD=

# Model runtime
OLLAMA_HOST=

# Embedding contract — must MATCH apps/lab/.env's EMBEDDING_CONFIG_VERSION.
# Changing it silently invalidates every stored vector (§12.2, FR-005).
EMBEDDING_CONFIG_VERSION=

# Bind address — loopback only (FR-001)
SERVICE_HOST=
SERVICE_PORT=
